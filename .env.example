# One Step Ahead — live mode configuration.
# Copy this file to ".env", then fill in your key. ".env" is git-ignored.
# NEVER commit a real key. Without a key the app still runs in Demo mode.

# Required for live mode. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE

# Optional: which Claude model the proxy calls (any current Messages API model ID).
MODEL=claude-sonnet-4-5

# Optional: port for server.js (default 3000).
PORT=3000
